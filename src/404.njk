---
layout: base.njk
title: "404 - Shrinath Prabhu"
robots: "noindex, nofollow"
permalink: /404.html
extraCSS: |
  .page-404 {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: calc(100vh - 60px);
    padding: 24px;
    text-align: center;
  }
  .page-404__code {
    font-family: var(--font-heading);
    font-size: clamp(5rem, 15vw, 10rem);
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1;
    letter-spacing: -0.04em;
    opacity: 0.08;
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 0;
    user-select: none;
    pointer-events: none;
  }
  .page-404__content {
    position: relative;
    z-index: 1;
    max-width: 480px;
  }
  .page-404__title {
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: 8px;
    color: var(--text-primary);
    text-wrap: balance;
  }
  .page-404__subtitle {
    font-size: 0.95rem;
    color: var(--text-secondary);
    margin-bottom: 28px;
    line-height: 1.6;
  }
  .game-container {
    width: 100%;
    max-width: 480px;
    margin: 0 auto 20px;
    position: relative;
  }
  .game-canvas {
    width: 100%;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-card);
    cursor: pointer;
    display: block;
  }
  .game-prompt {
    font-size: 0.8rem;
    color: var(--text-tertiary);
    margin-bottom: 24px;
    transition: opacity 0.3s ease-in;
  }
  .game-score {
    font-family: var(--font-heading);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-secondary);
    margin-bottom: 4px;
  }
  .page-404__links {
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
  }
  .page-404__easter {
    font-size: 0.75rem;
    color: var(--text-tertiary);
    margin-top: 32px;
    opacity: 0.5;
    transition: opacity 0.3s;
  }
  .page-404__easter:hover {
    opacity: 1;
  }
---

<div class="page-404">
  <div class="page-404__code">404</div>
  <div class="page-404__content fade-in">
    <div class="page-404__title">
      Shipped too fast, forgot to deploy this page.
    </div>
    <div class="page-404__subtitle">
      While you're here, try beating my high score.
    </div>

    <div class="game-container">
      <canvas
        class="game-canvas"
        id="game"
        width="480"
        height="160"
      ></canvas>
    </div>
    <div class="game-score" id="score">Score: 0 &nbsp;·&nbsp; Best: 0</div>
    <div class="game-prompt" id="prompt">Press Space or tap to start</div>

    <div class="page-404__links">
      <a href="/" class="btn btn--primary">Back to home →</a>
      <a href="/work/" class="btn btn--secondary">See my work</a>
    </div>

    <div class="page-404__easter" id="easter">
      💡 Pro tip: you can also press ↑ to jump
    </div>
  </div>
</div>

<script src="/js/game.js" defer></script>
