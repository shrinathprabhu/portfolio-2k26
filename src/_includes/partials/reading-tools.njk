<div class="reading-tools glass glass--liquid" role="group" aria-label="Reading tools" hidden>
  <div class="reading-tools__progress">
    <progress value="0" max="100" aria-label="Reading progress"></progress>
    <span aria-hidden="true">0%</span>
  </div>
  <button class="btn btn--quiet reading-tools__copy" type="button">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a4 4 0 0 0 6 .5l4-4a4 4 0 0 0-5.7-5.7L12 6m2 5a4 4 0 0 0-6-.5l-4 4a4 4 0 0 0 5.7 5.7L12 18"/></svg>
    <span role="status">Copy link</span>
  </button>
  <button class="btn btn--quiet btn--icon reading-tools__top" type="button" aria-label="Back to top">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V5m-6 6 6-6 6 6"/></svg>
  </button>
</div>

<script src="/js/reading.js?v={{ '/js/reading.js' | rev }}" defer></script>
