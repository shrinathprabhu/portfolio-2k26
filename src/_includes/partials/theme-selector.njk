{# Miniature app previews inspired by https://www.rareui.com/components/themeselector #}
{% macro preview(palette) %}
  <svg class="theme-preview__screen theme-preview__screen--{{ palette }}" viewBox="0 0 120 90" fill="none" aria-hidden="true">
    <rect x="14" y="15" width="122" height="87" rx="7" fill="var(--preview-sidebar)" />
    <g fill="var(--preview-muted)">
      <circle cx="21" cy="22" r="1.5" /><circle cx="27" cy="22" r="1.5" /><circle cx="33" cy="22" r="1.5" />
      <rect x="20" y="32" width="23" height="4" rx="2" />
      <rect x="20" y="42" width="18" height="3" rx="1.5" />
      <rect x="20" y="51" width="14" height="3" rx="1.5" />
      <circle cx="23" cy="80" r="3" /><rect x="29" y="78" width="12" height="3" rx="1.5" />
    </g>
    <rect x="49" y="19" width="87" height="83" rx="6" fill="var(--preview-page)" />
    <rect x="56" y="27" width="24" height="4" rx="2" fill="var(--preview-ink)" />
    <rect x="56" y="35" width="17" height="3" rx="1.5" fill="var(--preview-muted)" />
    <g fill="var(--preview-card)">
      <rect x="56" y="45" width="21" height="18" rx="4" />
      <rect x="81" y="45" width="21" height="18" rx="4" />
      <rect x="106" y="45" width="21" height="18" rx="4" />
      <rect x="56" y="67" width="71" height="25" rx="4" />
    </g>
  </svg>
{% endmacro %}

<div class="theme-selector" hidden>
  <button class="theme-selector__toggle" type="button" aria-label="Appearance: System" title="Appearance: System" aria-expanded="false" aria-controls="theme-panel">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
      <circle cx="12" cy="12" r="8" />
      <path d="M12 4a8 8 0 0 0 0 16Z" fill="currentColor" stroke="none" />
    </svg>
  </button>
  <div class="theme-selector__panel" id="theme-panel" hidden>
    <fieldset class="theme-selector__fieldset" aria-describedby="theme-description">
      <legend>Appearance</legend>
      <p id="theme-description">Choose your view.</p>
      <div class="theme-selector__options">
        {% for value, label in [["light", "Light"], ["dark", "Dark"], ["system", "System"]] %}
        <label class="theme-option">
          <input class="theme-option__input" type="radio" name="theme" value="{{ value }}"{% if value == "system" %} checked{% endif %} />
          <span class="theme-preview theme-preview--{{ value }}" aria-hidden="true">
            {{ preview("light" if value == "system" else value) }}
            {% if value == "system" %}{{ preview("dark") }}{% endif %}
            <span class="theme-preview__check">
              <svg width="10" height="10" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.8"><path d="m2.5 6 2.3 2.3 4.7-4.6" /></svg>
            </span>
          </span>
          <span class="theme-option__label">{{ label }}</span>
        </label>
        {% endfor %}
      </div>
    </fieldset>
    <p class="theme-selector__hint">System follows your device’s appearance.</p>
    <div class="theme-selector__motion">
      <div class="theme-selector__motion-row">
        <span id="motion-label">Animations</span>
        <button class="motion-toggle" type="button" role="switch" aria-checked="true" aria-labelledby="motion-label" aria-describedby="motion-status">
          <span class="motion-toggle__state" aria-hidden="true">On</span>
          <span class="motion-toggle__track" aria-hidden="true"><span></span></span>
        </button>
      </div>
      <p id="motion-status">Following your device setting.</p>
      <button class="motion-reset" type="button" hidden>Use device setting</button>
    </div>
  </div>
</div>
