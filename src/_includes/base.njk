<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    {# ── SEO & Meta ── #}
    {% include "partials/seo.njk" %}

    {# ── Favicon ── #}
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />

    {# ── Font preloads (eliminate FOUT) ── #}
    <link rel="preload" href="/fonts/outfit/outfit-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/dm-sans/dm-sans-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />

    {# ── Stylesheets ── #}
    <style>
      {% include "../styles.css" %}
    </style>
    {% if stylesheet %}
      {% if stylesheet == "/blog.css" %}
        <style>
          {% include "../blog.css" %}
        </style>
      {% else %}
        <link rel="stylesheet" href="{{ stylesheet }}" />
      {% endif %}
    {% endif %}

    {# ── Per-page inline CSS ── #}
    {% if extraCSS %}
    <style>
      {{ extraCSS | safe }}
    </style>
    {% endif %}

    {# ── Per-page extra <head> content (preload, prefetch, etc.) ── #}
    {% if extraHead %}
    {{ extraHead | safe }}
    {% endif %}

    {# ── RSS feed discovery ── #}
    <link rel="alternate" type="application/atom+xml" title="Shrinath Prabhu — Blog" href="/feed.xml" />
  </head>
  <body class="{{ bodyClass or '' }}">
    {% include "partials/header.njk" %}

    <main>
      {{ content | safe }}
    </main>

    {% include "partials/footer.njk" %}
  </body>
</html>
