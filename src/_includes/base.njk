<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f7fafb" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b1417" media="(prefers-color-scheme: dark)" />

    {# ── SEO & Meta ── #}
    {% include "partials/seo.njk" %}

    {# ── Favicon ── #}
    <link rel="icon" type="image/x-icon" href="/favicon.ico?v={{ '/favicon.ico' | rev }}" />

    {# ── Font preload: one variable family for the whole site ── #}
    <link rel="preload" href="/fonts/dm-sans/dm-sans-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />

    {# ── Stylesheets (inlined: no render-blocking requests) ── #}
    <style>
      {% inlineCss "styles.css" %}
    </style>
    {% if stylesheet %}
      {% if stylesheet == "/blog.css" %}
        <style>
          {% inlineCss "blog.css" %}
        </style>
      {% else %}
        <link rel="stylesheet" href="{{ stylesheet }}" />
      {% endif %}
    {% endif %}

    {# ── Per-page stylesheet file, inlined (path relative to src) ── #}
    {% if inlineStylesheet %}
    <style>
      {% inlineCss inlineStylesheet %}
    </style>
    {% endif %}

    {# ── Per-page inline CSS ── #}
    {% if extraCSS %}
    <style>
      {{ extraCSS | safe }}
    </style>
    {% endif %}

    {# ── Per-page extra <head> content (preload, prefetch, etc.) ── #}
    {% if extraHead %}
    {{ extraHead | safe }}
    {% endif %}

    {# ── RSS feed discovery ── #}
    <link rel="alternate" type="application/atom+xml" title="Shrinath Prabhu — Blog" href="/feed.xml" />
  </head>
  <body class="{{ bodyClass or '' }}">
    <a class="skip-link" href="#main">Skip to content</a>
    {% include "partials/header.njk" %}

    <main id="main">
      {{ content | safe }}
    </main>

    {% include "partials/footer.njk" %}
    {% include "partials/reading-tools.njk" %}
  </body>
</html>
