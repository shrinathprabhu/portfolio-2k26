<div class="page-header fade-in">
  <h1>Blog</h1>
  <p>
    Technical writing on frontend architecture, Chrome Extensions, and
    building products from zero to launch.
  </p>
</div>

<div>
  {% for post in collections.posts %}
  <a
    href="{{ post.url }}"
    class="blog-item fade-in"
    style="display: block; text-decoration: none; color: inherit"
  >
    <div class="blog-item__title">{{ post.data.title }}</div>
    <div class="blog-item__desc">{{ post.data.description }}</div>
    <div class="blog-item__meta">
      {% if post.data.category %}
      <span class="blog-item__tag">{{ post.data.category }}</span>
      {% endif %}
      <span style="margin-left: 8px">{{ post.date | readableDate }}</span>
      <span> · {{ post.data.readingTime or (post.templateContent | readingTime) }}</span>
    </div>
    {% if post.data.postTags %}
    <div class="tags" style="margin-top: 8px;">
      {% for tag in post.data.postTags %}
      <span class="tag" style="font-size: 0.75rem;">{{ tag }}</span>
      {% endfor %}
    </div>
    {% endif %}
  </a>
  {% endfor %}
</div>

<div
  style="
    text-align: center;
    padding: 40px 0 16px;
    border-top: 1px solid var(--border-light);
  "
>
  <p style="margin-bottom: 16px">
    Want to see the projects behind the posts?
  </p>
  <a href="/work/" class="btn btn--primary">View Case Studies →</a>
</div>
