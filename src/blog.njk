---

<div class="page-header fade-in">
  <h1>Blog</h1>
  <p>
    Technical writing on frontend architecture, Chrome Extensions, and
    building products from zero to launch.
  </p>
</div>

<div class="blog-grid">
  {% for post in collections.posts %}
  <a
    href="{{ post.url }}"
    class="blog-card fade-in{% if post.data.featured %} blog-card--featured{% endif %}"
    style="text-decoration: none; color: inherit"
  >
    {% if post.data.image %}
    <div class="blog-card__image">
      <img src="{{ post.data.image }}" alt="{{ post.data.title }}" loading="lazy" />
    </div>
    {% endif %}
    <div class="blog-card__body">
      {% if post.data.featured %}
      <span class="blog-card__featured">★ Featured</span>
      {% endif %}
      <div class="blog-card__title">{{ post.data.title }}</div>
      <div class="blog-card__desc">{{ post.data.description }}</div>
      <div class="blog-card__footer">
        {% if post.data.category %}
        <div style="margin-bottom: 6px;">
          <span class="blog-item__tag">{{ post.data.category }}</span>
        </div>
        {% endif %}
        <div class="blog-item__meta">
          <span>{{ post.date | readableDate }}</span>
          <span> · {{ post.data.readingTime or (post.templateContent | readingTime) }}</span>
        </div>
      </div>
    </div>
  </a>
  {% endfor %}
</div>

<div
  style="
    text-align: center;
    padding: 40px 0 16px;
  "
>
  <p style="margin-bottom: 16px">
    Want to see the projects behind the posts?
  </p>
  <a href="/work/" class="btn btn--primary">View Case Studies →</a>
</div>
