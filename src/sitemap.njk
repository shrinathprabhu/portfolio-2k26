---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {%- for page in collections.all %}
  {%- if not page.data.eleventyExcludeFromCollections and page.url and page.data.robots != "noindex, nofollow" %}
  <url>
    <loc>https://shrinath.me{{ page.url }}</loc>
    {#- lastmod only where a real edit date is known; a build-time "now" on
        every URL teaches crawlers to ignore the field. Posts use their
        visible "Updated" date (dateModified) so the sitemap, the page and its
        structured data agree; other pages use the source file's last commit. #}
    {%- if page.data.category %}
    <lastmod>{{ (page.data.dateModified or page.date) | ymd }}</lastmod>
    {%- elif page.data.dateModified %}
    <lastmod>{{ page.data.dateModified | ymd }}</lastmod>
    {%- else %}{% set edited = page.inputPath | lastEdited %}{% if edited %}
    <lastmod>{{ edited | ymd }}</lastmod>
    {%- endif %}{% endif %}
  </url>
  {%- endif %}
  {%- endfor %}
</urlset>
